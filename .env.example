# Environment Variables
# cp .env.example .env
# Production Secretは使用しない

# Workers AI (app extraction and pnpm eval). Use a token with Workers AI permissions only.
# If either is empty, the app uses the fixed sample extractor.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional. One of WORKERS_AI_VISION_CANDIDATES in src/server/workersAi.ts.
WORKERS_AI_MODEL=

# OpenAI (app extraction and pnpm eval). Takes precedence over Workers AI when set.
OPENAI_API_KEY=
# Optional. One of OPENAI_VISION_CANDIDATES in src/server/openai.ts.
OPENAI_MODEL=
